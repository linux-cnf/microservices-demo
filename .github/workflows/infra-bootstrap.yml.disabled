name: infra-bootstrap

on:
  push:
    branches: [main]
    paths:
      - 'terraform/**'
      - 'argocd/**'
      - '.github/workflows/infra-bootstrap.yml'
  workflow_dispatch:
    inputs:
      run_apply:
        description: "Run terraform apply?"
        required: true
        default: "false"

permissions:
  contents: read
  id-token: write

concurrency:
  group: terraform-live-main
  cancel-in-progress: false

jobs:
  infra:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Authenticate to GCP
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.GCP_WIF_PROVIDER }}
          service_account: ${{ secrets.GCP_SERVICE_ACCOUNT }}

      - name: Setup gcloud
        uses: google-github-actions/setup-gcloud@v3
        with:
          project_id: project-9e0b2bd9-4649-487c-9d1

      - name: Verify auth
        run: |
          gcloud auth list
          gcloud config list
          gcloud projects describe project-9e0b2bd9-4649-487c-9d1 --format="value(projectNumber)"

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.14.8

      - name: Terraform init
        working-directory: terraform/live/main
        run: terraform init

      - name: Terraform fmt check
        working-directory: terraform/live/main
        run: terraform fmt -check -recursive

      - name: Terraform validate
        working-directory: terraform/live/main
        run: terraform validate

      - name: Terraform plan
        working-directory: terraform/live/main
        env:
          TF_INPUT: "false"
          TF_VAR_gcp_project_id: ${{ secrets.GCP_PROJECT_ID }}
        run: terraform plan -input=false -out=tfplan

      - name: Terraform apply
        if: github.event_name == 'workflow_dispatch' && github.event.inputs.run_apply == 'true'
        working-directory: terraform/live/main
        env:
          TF_INPUT: "false"
          TF_VAR_gcp_project_id: ${{ secrets.GCP_PROJECT_ID }}
        run: terraform apply -input=false -auto-approve tfplan

      - name: Configure Docker for Artifact Registry
        run: |
          gcloud auth configure-docker us-central1-docker.pkg.dev --quiet

      - name: Mirror approved third-party images to Artifact Registry
        run: |
          set -euo pipefail
          IMAGE_FILE="terraform/live/main/artifact_registry_seed_images.txt"
          if [ ! -f "${IMAGE_FILE}" ]; then
            echo "No third-party image inventory file found. Skipping."
            exit 0
          fi
          while IFS='|' read -r SOURCE_IMAGE TARGET_IMAGE; do
            if [[ -z "${SOURCE_IMAGE}" || "${SOURCE_IMAGE}" =~ ^# ]]; then
              continue
            fi
            echo "Processing ${SOURCE_IMAGE} -> ${TARGET_IMAGE}"
            if gcloud artifacts docker images describe "${TARGET_IMAGE}" >/dev/null 2>&1; then
              echo "Target image already exists, skipping: ${TARGET_IMAGE}"
              continue
            fi
            docker pull "${SOURCE_IMAGE}"
            docker tag "${SOURCE_IMAGE}" "${TARGET_IMAGE}"
            docker push "${TARGET_IMAGE}"
          done < "${IMAGE_FILE}"

      - name: Get cluster credentials
        uses: google-github-actions/get-gke-credentials@v3
        with:
          cluster_name: kfounding
          location: us-central1-a
          project_id: project-9e0b2bd9-4649-487c-9d1

      - name: Install Argo CD
        run: |
          kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
          kubectl apply --server-side --force-conflicts -n argocd \
            -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml

      - name: Wait for Argo CD
        run: |
          kubectl wait --for=condition=Available deployment/argocd-server -n argocd --timeout=600s
          kubectl wait --for=condition=Available deployment/argocd-repo-server -n argocd --timeout=600s

      - name: Validate Argo CD repo secrets
        env:
          ARGOCD_REPO_URL: ${{ secrets.ARGOCD_REPO_URL }}
          ARGOCD_REPO_USERNAME: ${{ secrets.ARGOCD_REPO_USERNAME }}
          ARGOCD_REPO_PASSWORD: ${{ secrets.ARGOCD_REPO_PASSWORD }}
        run: |
          test -n "$ARGOCD_REPO_URL"
          test -n "$ARGOCD_REPO_USERNAME"
          test -n "$ARGOCD_REPO_PASSWORD"
          echo "Argo CD repo secrets are present"

      - name: Create Argo CD repository secret
        env:
          ARGOCD_REPO_URL: ${{ secrets.ARGOCD_REPO_URL }}
          ARGOCD_REPO_USERNAME: ${{ secrets.ARGOCD_REPO_USERNAME }}
          ARGOCD_REPO_PASSWORD: ${{ secrets.ARGOCD_REPO_PASSWORD }}
        run: |
          kubectl apply -f - <<EOF
          apiVersion: v1
          kind: Secret
          metadata:
            name: repo-microservices-demo
            namespace: argocd
            labels:
              argocd.argoproj.io/secret-type: repository
          type: Opaque
          stringData:
            type: git
            url: ${ARGOCD_REPO_URL}
            username: ${ARGOCD_REPO_USERNAME}
            password: ${ARGOCD_REPO_PASSWORD}
          EOF

      - name: Bootstrap Argo CD apps boutique | observability| ECK operator| logging app
        run: |
          set -euo pipefail
          kubectl apply -f argocd/boutique-app.yaml -n argocd
          kubectl apply -f argocd/observability-app.yaml -n argocd
          kubectl apply -f argocd/eck-operator-app.yaml -n argocd

          echo "Waiting for Argo CD application eck-operator to become Healthy..."
          until [ "$(kubectl get application eck-operator -n argocd -o jsonpath='{.status.health.status}')" = "Healthy" ]; do
            kubectl get application eck-operator -n argocd
            sleep 5
          done

          kubectl apply -f argocd/logging-app.yaml -n argocd
          kubectl apply -f argocd/logging-agent-app.yaml -n argocd
          kubectl apply -f argocd/tracing-app.yaml -n argocd
