          "expr": "(\n  100 *\n  sum(\n    rate(\n      ai_llm_gateway_errors_total{\n        namespace=\"__AI_NAMESPACE__\"\n      }[5m]\n    )\n  )\n  /\n  clamp_min(\n    sum(\n      rate(\n        ai_llm_gateway_requests_total{\n          namespace=\"__AI_NAMESPACE__\"\n        }[5m]\n      )\n    ),\n    0.001\n  )\n) or vector(0)",
