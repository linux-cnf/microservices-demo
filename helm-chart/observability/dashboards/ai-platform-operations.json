  "description": "Production-only operations dashboard for the AI platform. Monitors the LLM Gateway, Agent Orchestrator, Ollama and Redis, including application traffic, tool usage, latency, errors, availability and workload resource consumption. Provisioned through GitOps.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "AI Platform Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prometheus Targets Healthy",
      "description": "Number of healthy Prometheus scrape targets for the AI LLM Gateway and AI Agent Orchestrator. Expected value: 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(\n  up{\n    namespace=\"__AI_NAMESPACE__\",\n    service=~\"ai-llm-gateway|ai-agent-orchestrator\"\n  } == 1\n)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI Workloads Available",
      "description": "Number of available AI Deployments. Expected value: 4 for gateway, agent, Ollama and Redis.",
